{
  "title": "NASA EONET Natural Disaster Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "category": {
      "title": "Event Category",
      "type": "string",
      "default": "all",
      "description": "Category filter: all, severeStorms, wildfires, volcanoes, seaLakeIce"
    },
    "status": {
      "title": "Status",
      "type": "string",
      "default": "open",
      "description": "Event status: open or all"
    },
    "maxItems": {
      "title": "Max Results",
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    }
  }
}